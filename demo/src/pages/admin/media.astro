---
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaLibrary from '../../components/MediaLibrary.tsx';

export const prerender = false;
---
<AdminLayout title="Media Library" active="media" wide>
  <div class="page-header">
    <div>
      <span class="eyebrow">Media</span>
      <h1>Media Library</h1>
      <p>In this demo, uploads stay in your browser and clear when your demo session resets. A real deployment stores them in object storage (R2/S3).</p>
    </div>
  </div>

  <MediaLibrary client:load sandboxId={Astro.locals.sandbox?.id ?? ''} />
</AdminLayout>
