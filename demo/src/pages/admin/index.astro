---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DashboardStats from '../../components/DashboardStats.tsx';
import { getSandboxedPostService } from '../../lib/sandbox-store';
import { displayStatus } from '@thecbcreative/blog-admin/core';
import { withBase } from '../../lib/base-path';

export const prerender = false;

const service = getSandboxedPostService(Astro.locals, Astro.cookies);
const [draft, scheduled, published, archived, recent] = await Promise.all([
  service.count('draft'),
  service.count('scheduled'),
  service.count('published'),
  service.count('archived'),
  service.list({ limit: 6 }),
]);

// Set by PostComposer after a publish; the headline is looked up rather than
// trusted from the URL.
const publishedId = Astro.url.searchParams.get('published');
const justPublished = publishedId ? await service.get(publishedId) : null;
const justDeleted = Astro.url.searchParams.has('deleted');
---
<AdminLayout title="Dashboard" active="dashboard">
  <div class="page-header">
    <div>
      <span class="eyebrow">Overview</span>
      <h1>Dashboard</h1>
      <p>An overview of everything in this seeded demo.</p>
    </div>
    <a class="btn btn-primary" href={withBase('/admin/posts/new')}>+ New Post</a>
  </div>

  {justPublished && (
    <div class="flash-success" role="status">
      “{justPublished.headline}” was published.
    </div>
  )}

  {justDeleted && (
    <div class="flash-success" role="status">Post deleted.</div>
  )}

  <DashboardStats client:load counts={{ draft, scheduled, published, archived }} />

  <div class="card">
    <span class="eyebrow" style="margin-bottom:14px;">Recently updated</span>
    {recent.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <table>
        <thead>
          <tr><th>Headline</th><th>Status</th><th>Author</th><th>Updated</th></tr>
        </thead>
        <tbody>
          {recent.map((p) => (
            <tr>
              <td class="headline"><a href={withBase(`/admin/posts/${p.id}/edit`)}>{p.headline}</a></td>
              <td><span class={`badge badge-${displayStatus(p)}`}>{displayStatus(p)}</span></td>
              <td>{p.authorName}</td>
              <td>{p.updatedAt.toLocaleDateString()}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</AdminLayout>

<script>
  // Drop the one-shot flags so a reload doesn't show the banner again.
  const url = new URL(window.location.href);
  if (url.searchParams.has('published') || url.searchParams.has('deleted')) {
    url.searchParams.delete('published');
    url.searchParams.delete('deleted');
    history.replaceState(null, '', url);
  }
</script>
