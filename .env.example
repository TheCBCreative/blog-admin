# ── Database (Neon) ──
# Use the POOLED connection string (hostname contains -pooler).
DATABASE_URL=

# ── Better Auth ──
# 32+ chars, high entropy:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the site. http://localhost:4321 for local Astro dev.
BETTER_AUTH_URL=

# ── Object storage for media (M4c) ──
# Neon Object Storage is S3-compatible and only available in us-east-2.
# Cloudflare R2 is the alternative if you'd rather not depend on the beta.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=
