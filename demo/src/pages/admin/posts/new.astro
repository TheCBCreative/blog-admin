---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostComposer from '../../../components/PostComposer.tsx';
import { DEMO_LAYOUTS } from '../../../lib/store';

export const prerender = false;
---
<AdminLayout title="New Post" active="posts">
  <div class="page-header">
    <div>
      <span class="eyebrow">Posts</span>
      <h1>New Post</h1>
      <p>Draft, schedule, or publish immediately.</p>
    </div>
    <a class="btn btn-ghost" href="/admin/posts">← Back to posts</a>
  </div>

  <PostComposer client:load mode="create" layouts={[...DEMO_LAYOUTS]} />
</AdminLayout>
