# ── Production (Vercel + Neon) ──
# Pooled Neon connection string.
DATABASE_URL=
# 32+ chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the deployed demo, e.g. https://blog-composer-demo.vercel.app
BETTER_AUTH_URL=

# ── Visitor content cleanup (see ./DEMO_DEPLOY.md#cleaning-up-visitor-posts) ──
# Hours a visitor-created post is kept before it's auto-deleted. Seeded
# placeholder posts (npm run db:seed) are never deleted, regardless of age.
# Optional — defaults to 2 if unset.
DEMO_POST_MAX_AGE_HOURS=2
# Optional. If set, POST /api/cron/cleanup requires this value as a Bearer
# token — only needed if you also wire up a Vercel Cron job as a stricter,
# schedule-driven backstop to the built-in traffic-driven cleanup.
CRON_SECRET=

# ── Local development only (see ./LOCAL_DEV.md) ──
# Set LOCAL_PG=true to use the plain-Postgres dev adapter instead of Neon's
# HTTP driver, and point DATABASE_URL at a local/self-hosted Postgres.
# Better Auth's own Postgres client (Pool) still needs a WS relay to reach a
# non-Neon database locally — LOCAL_WS_RELAY documents that address.
LOCAL_PG=false
LOCAL_WS_RELAY=
