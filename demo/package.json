{
  "name": "blog-admin-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live, seeded demo of @thecbcreative/blog-admin \u2014 an Astro app with React islands for the interactive admin screens.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:setup": "node --env-file=.env --import ./scripts/local-neon-shim.mjs ../scripts/migrate.mjs && tsx --env-file=.env --import ./scripts/local-neon-shim.mjs ../scripts/migrate-auth.ts",
    "db:seed": "tsx --env-file=.env --import ./scripts/local-neon-shim.mjs scripts/seed-demo.ts"
  },
  "dependencies": {
    "@thecbcreative/blog-admin": "file:..",
    "astro": "^5.2.0",
    "@astrojs/react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@astrojs/vercel": "^9.0.0",
    "@neondatabase/serverless": "^1.0.0",
    "better-auth": "^1.3.0",
    "resend": "^6.18.1",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "htmlparser2": "9.1.0"
  }
}
