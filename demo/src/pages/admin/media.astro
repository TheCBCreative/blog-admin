---
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaLibrary from '../../components/MediaLibrary.tsx';

export const prerender = false;
---
<AdminLayout title="Media Library" active="media">
  <div class="page-header">
    <div>
      <span class="eyebrow">Media</span>
      <h1>Media Library</h1>
      <p>Uploads are stored on local disk for this demo — a production deployment would wire real object storage.</p>
    </div>
  </div>

  <MediaLibrary client:load />
</AdminLayout>
